<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> | Motors</title>
  <link rel="stylesheet" href="/css/main.css">
</head>
<body>
  <header>
    <h1>Motors</h1>
    <p>Your trusted source for vehicles</p>
  </header>

  <main class="container">
    <h1><%= title %></h1>

    <div class="vehicle-detail">
      <!-- Vehicle HTML built in utilities.buildVehicleDetail -->
      <%- vehicleHTML %>
    </div>
  </main>

  <footer>
    <p>&copy; <%= new Date().getFullYear() %> Motors. All rights reserved.</p>
  </footer>
</body>
</html>
